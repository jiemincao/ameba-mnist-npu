calib/

# Pico 2 CMake 建置產物
# _build      手動 cmake 用的
# _build_ext  VSCode 擴充用另一個 kit 編的（驗證兩套 toolchain 時開的）
# build       擴充的 Compile Project 預設輸出，也是 tasks.json 裡寫死的路徑
pico2/**/_build/
pico2/**/_build_ext/
pico2/**/build/

# arduino-cli --build-path 的輸出（編譯暫存,可重建）
_bp_*/

# Python
__pycache__/

# 打包給 Colab 用的資料集(可由 dataset/ 重新產生)
dataset.zip

# 人工挑掉的壞照片(留著可還原,不進 repo)
dataset/_rejected/

